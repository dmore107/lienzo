{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lienzo",
  "version": "0.1.0",
  "identifier": "com.dani.lienzo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lienzo",
        "width": 1180,
        "height": 740,
        "minWidth": 340,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
