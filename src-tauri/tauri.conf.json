{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lienzo",
  "version": "0.9.0",
  "identifier": "com.dani.lienzo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lienzo",
        "width": 1180,
        "height": 740,
        "minWidth": 340,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Daniel Moreno",
    "shortDescription": "Portapapeles con lienzo y línea de tiempo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMjUxQjVFM0MzN0Y1N0YKUldSLzlUYzhYaHNsdS84aENzTXBNUTk3eit4VHZpOEV3UFRIRXRML3F6M3N0ME83LzJXa2xIdUQK",
      "endpoints": ["https://github.com/dmore107/lienzo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
